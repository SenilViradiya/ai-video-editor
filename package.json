{
  "name": "ai-video-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "preview": "remotion render src/index.tsx TalkingHead --scale=0.5 previews/preview.mp4",
    "render": "remotion render src/index.tsx TalkingHead output/final-reel.mp4",
    "render:semantic": "node --experimental-strip-types tools/prepare-render-job.mjs && remotion render src/index.tsx SemanticTalkingHead output/final-semantic-reel.mp4 --concurrency=1",
    "preview:semantic": "remotion render src/index.tsx SemanticTalkingHeadPreview --scale=0.5 previews/semantic-preview.mp4",
    "render:test": "remotion render src/index.tsx SemanticTalkingHeadPreview output/test-1080p30.mp4",
    "policy:test": "node --experimental-strip-types tools/test-output-policy.mjs",
    "intermediate:source": "node --experimental-strip-types tools/create-source-intermediate.mjs",
    "render:hybrid": "node --experimental-strip-types tools/render-hybrid.mjs",
    "render:semantic:hybrid": "node --experimental-strip-types tools/render-hybrid.mjs",
    "plan:p1": "node --experimental-strip-types tools/build-source-transcript.mjs && node --experimental-strip-types tools/analyze-references.mjs && node --experimental-strip-types tools/build-semantic-plan.mjs",
    "transcript:import": "node --experimental-strip-types tools/import-manual-transcript.mjs",
    "reference:p2": "python tools/analyze-temporal-video.py .",
    "transcribe:base": "python tools/transcribe-local.py .",
    "transcript:candidates": "node --experimental-strip-types tools/build-transcript-candidate-report.mjs",
    "input:detect": "node --experimental-strip-types tools/input-mode.mjs",
    "hindi:review": "node --experimental-strip-types tools/hindi-transcript-review.mjs",
    "hindi:transcribe": "python tools/transcribe-hindi-mp3.py .",
    "hindi:plan": "node --experimental-strip-types tools/build-hindi-story-plan.mjs",
    "validate:hindi-preview": "node --experimental-strip-types tools/validate-hindi-preview.mjs",
    "preview:p2.4": "remotion render src/index.tsx HindiCinematicPreview previews/p2.4-cinematic-story-preview.mp4",
    "test:cinematic-story": "node tools/test-cinematic-story.mjs",
    "test:modes": "node --experimental-strip-types tools/test-dual-input-modes.mjs",
    "test:hindi-type": "node --experimental-strip-types tools/test-hindi-typography.mjs",
    "plan:p2": "node --experimental-strip-types tools/build-source-transcript.mjs && node --experimental-strip-types tools/build-p2-scene-plan.mjs",
    "test:effects": "node tools/test-effect-registry.mjs",
    "test:p2": "node tools/test-p2-artifacts.mjs",
    "validate:output": "node --experimental-strip-types tools/validate-output.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node tools/validate-edit-plan.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
